# Hybrid local voice profile: local STT + configurable OpenAI-compatible LLM + local Piper TTS
DEFAULT_PROFILE=hybrid_local_vi

# Server
HOST=0.0.0.0
PORT=8000
MAX_SESSIONS=4
LOCAL_STT_MAX_SESSIONS=1
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
METRICS_JSONL_PATH=artifacts/runtime-metrics.jsonl

# Security — replace both before LAN deployment
PROVISIONING_SECRET=dev-provisioning-secret
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_EXPIRY_SECONDS=3600
HEARTBEAT_TIMEOUT_SECONDS=30

# OpenAI-compatible LLM. Change all three without editing source code.
# Examples:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
#   Ollama:  LLM_BASE_URL=http://127.0.0.1:11434/v1
#   vLLM:    LLM_BASE_URL=http://127.0.0.1:8001/v1
#   Other gateways: use their exact OpenAI-compatible /v1 endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-token
LLM_MODEL=gpt-4.1
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_ON_TIMEOUT=true
# Optional extra headers, as one JSON object. Keep {} for standard Bearer-token APIs.
LLM_DEFAULT_HEADERS_JSON={}

# Local Whisper STT
# auto = MLX on Apple Silicon; Faster-Whisper elsewhere.
LOCAL_STT_BACKEND=auto
WHISPER_MLX_MODEL=mlx-community/whisper-large-v3-turbo-q4
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
WHISPER_NO_SPEECH_PROB=0.6
WHISPER_TEMPERATURE=0.0

# Piper HTTP sidecar
PIPER_BASE_URL=http://127.0.0.1:5000
PIPER_VOICE=vi_VN-vais1000-medium
PIPER_REQUEST_TIMEOUT_SECONDS=20
