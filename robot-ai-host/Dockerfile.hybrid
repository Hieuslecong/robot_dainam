# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS browser-build
WORKDIR /src/clients/browser
COPY clients/browser/package.json clients/browser/package-lock.json ./
RUN npm ci
COPY clients/browser/ ./
RUN npm run test && npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ pkg-config ffmpeg \
    libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev \
    libavutil-dev libswresample-dev libswscale-dev \
    libopus-dev libvpx-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.10.0

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY app ./app
COPY config ./config
RUN uv sync --frozen --no-dev && \
    uv pip install --python /opt/venv/bin/python 'pipecat-ai[whisper]==1.6.0'

COPY scripts ./scripts
COPY README.md ARCHITECTURE.md API.md TESTING.md DEPLOYMENT.md KNOWN_LIMITATIONS.md HYBRID_DEPLOYMENT.md ./
COPY --from=browser-build /src/clients/browser/dist ./clients/browser/dist
RUN mkdir -p /app/artifacts /root/.cache/huggingface

EXPOSE 8000
CMD ["python", "-m", "app.main", "--host", "0.0.0.0", "--port", "8000", "--profile", "hybrid_local_vi"]
