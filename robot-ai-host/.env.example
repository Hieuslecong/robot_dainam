# Robot AI Host Server — copy to .env and replace development secrets.

# Server
HOST=0.0.0.0
PORT=8000
MAX_SESSIONS=4
LOG_LEVEL=INFO
DEFAULT_PROFILE=mock
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
METRICS_JSONL_PATH=artifacts/runtime-metrics.jsonl

# Session/security (change for any LAN deployment)
PROVISIONING_SECRET=dev-provisioning-secret
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_EXPIRY_SECONDS=3600
HEARTBEAT_TIMEOUT_SECONDS=30

# Deterministic mock test harness — NOT speech recognition or natural TTS.
MOCK_AUTO_TRANSCRIBE=true
MOCK_SCRIPTED_TRANSCRIPTS=Xin chào, tôi là người dùng thử nghiệm|Tên tôi là Minh Hiếu|Tôi vừa nói tên gì

# Google Cloud Speech-to-Text / Text-to-Speech for the google_vi profile.
# Use an absolute path on macOS. Do not copy the credential JSON into Docker images.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_LOCATION=global
GOOGLE_STT_MODEL=latest_long
# Required. Set a verified Vietnamese Google voice supported by your account/region.
GOOGLE_TTS_VOICE=
GOOGLE_TTS_SPEAKING_RATE=1.0

# OpenAI LLM for the google_vi cascade profile.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Generic OpenAI-compatible LLM (preferred over legacy OPENAI_* variables).
# Leave LLM_BASE_URL empty to use OpenAI's default endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_ON_TIMEOUT=true
LLM_DEFAULT_HEADERS_JSON={}

# Hybrid local voice profile: Whisper STT + configurable LLM + Piper HTTP TTS.
LOCAL_STT_BACKEND=auto
LOCAL_STT_MAX_SESSIONS=1
WHISPER_MLX_MODEL=mlx-community/whisper-large-v3-turbo-q4
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
WHISPER_NO_SPEECH_PROB=0.6
WHISPER_TEMPERATURE=0.0
PIPER_BASE_URL=http://127.0.0.1:5000
PIPER_VOICE=vi_VN-vais1000-medium
PIPER_REQUEST_TIMEOUT_SECONDS=20

# Persona (spec 9.4). Final name pending school confirmation — do not hard-code.
PERSONA_NAME=Trợ lý AI của trường

# STT candidate selection (spec 8.1) — name from config/stt_candidates.yaml.
# Empty = legacy WHISPER_* variables. The default only changes after gate 8.6.
STT_CANDIDATE=

# Optional role models (spec 9.1); empty falls back to LLM_MODEL.
LLM_ROUTER_MODEL=
LLM_EXECUTOR_MODEL=
LLM_PLANNER_MODEL=

# Silero VAD tuning (spec 8.5) — tune with real recordings.
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.8
VAD_MIN_VOLUME=0.6

# Public-space idle/active gate (spec 8.7). Enable on robot deployments;
# wake via RTVI robot.wake (button/touch). Browser dev keeps it off.
WAKE_MODE_ENABLED=false
IDLE_TIMEOUT_SECONDS=30

# Glossary correction (spec 8.3) — config/glossary.yaml.
GLOSSARY_ENABLED=true

# Persistent user memory (PR-1: off by default for public robots).
# Enable only with consent, identity, retention policy, and delete/export.
PERSISTENT_USER_MEMORY=false

# Two-tier TTS (spec 16.2a): Piper opener + VieNeu expressive tier.
# Turn on only after listening to artifacts/upgrade/vieneu_smoke.wav.
TTS_TWO_TIER_ENABLED=false
